# ====================================================================
# Copy this file to .env and fill in the three API keys.
# EVERY setting the program uses lives here. Nothing is hardcoded in the code.
# ====================================================================

# ---------- API keys (never share or commit these) ----------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
# DEBUG shows every step (very detailed), INFO shows the important ones
LOG_LEVEL=INFO

# ---------- OpenAI (the "brain") ----------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Hard limit on the length of every answer (keeps replies short and fast to speak). Minimum 16.
OPENAI_MAX_OUTPUT_TOKENS=150
# How long the HTTPS connection to OpenAI may sit idle before it is closed (library default is 5)
OPENAI_KEEPALIVE_EXPIRY_SECONDS=120
# How often a tiny free request keeps that connection warm
OPENAI_WARM_INTERVAL_SECONDS=20
# How many past messages (user + assistant together) are sent with each question
HISTORY_MAX_MESSAGES=20
SYSTEM_PROMPT="You are a helpful voice assistant. Speak naturally and concisely. Answer the user's actual question directly. For simple questions, use 1 to 3 short sentences. Avoid markdown, tables, lists, emoji, long introductions, and repetition."

# ---------- Deepgram (the "ears") ----------
# Flux needs the /v2/listen address and a flux model name
DEEPGRAM_WS_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_MODEL=flux-general-en
# The browser sends 16-bit PCM at this sample rate
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000
# How sure Deepgram must be that you finished talking (0.5 to 1.0). Lower = faster but may cut you off.
DEEPGRAM_EOT_THRESHOLD=0.7
# Start the LLM EARLY when Deepgram is this sure (0.3 to 0.9, must not exceed the value above).
# Leave EMPTY to switch the early start off.
DEEPGRAM_EAGER_EOT_THRESHOLD=0.4
# Force the end of your turn after this much silence, in milliseconds
DEEPGRAM_EOT_TIMEOUT_MS=6000

# ---------- ElevenLabs (the "mouth") ----------
ELEVENLABS_WS_BASE_URL=wss://api.elevenlabs.io
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
# Must be a pcm format. The number is the sample rate the browser will play at.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_INACTIVITY_TIMEOUT=180
# ElevenLabs waits for this many characters before it starts speaking (each value must be 50 or more)
ELEVENLABS_CHUNK_SCHEDULE=50,80,120,160
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_AUTO_MODE=false
TTS_CONNECT_TIMEOUT_SECONDS=15
# Longest time to wait for one reply's audio to finish generating
TURN_TIMEOUT_SECONDS=60

# ---------- Text chunking (what goes to the voice, and when) ----------
# The first spoken phrase is cut this early (in characters) so speech starts fast
FIRST_CHUNK_CHARS=28
CHUNK_TARGET_CHARS=50
CHUNK_MAX_EXTRA_CHARS=6

# ---------- Browser audio ----------
# The microphone is sent in pieces this long. Flux recommends 80.
MIC_CHUNK_MS=80

# ---------- Behaviour ----------
# true: you can interrupt the assistant by talking (use headphones).
# false: speech while the assistant talks is ignored (use this if you test on speakers).
BARGE_IN_ENABLED=true
# Stop listening after this many seconds with no speech (saves Deepgram credits)
IDLE_TIMEOUT_SECONDS=180
# Extra seconds to wait for the browser to report that it finished playing
DRAIN_GRACE_SECONDS=3